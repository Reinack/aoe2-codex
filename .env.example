# Ruta absoluta a la wiki pública de AoE2 (bóveda Obsidian, read-only). Es la versión
# curada de la bóveda de trabajo D:\Boveda\Aoe: lo que se publica en la web y el chat.
VAULT_PATH=D:\Boveda\AoE-Wiki

# Carpetas a excluir del ingest (separadas por coma, relativas al vault)
EXCLUDE_DIRS=.obsidian,.trash,raw

# Conexión a Neo4j — local (docker compose; la password debe coincidir con la de
# docker-compose.yml, solo sirve para desarrollo).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codexpass

# Neo4j Aura (cloud): reemplazá el bloque de arriba por los datos de la instancia
# (el .txt que descarga Aura al crearla). En Aura el usuario suele ser el ID de la
# instancia, NO 'neo4j'; NEO4J_USERNAME (el nombre que usa ese .txt) también se acepta.
#NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
#NEO4J_USER=<instance-id>
#NEO4J_PASSWORD=<password-de-la-instancia>

# Origen de `python -m codex.copy_to_aura` (copia el grafo local a Aura; el
# destino es el NEO4J_* de arriba). Por defecto, el Neo4j local de docker compose.
#SRC_NEO4J_URI=bolt://localhost:7687
#SRC_NEO4J_USER=neo4j
#SRC_NEO4J_PASSWORD=codexpass

# Proveedor LLM: 'gemini' (cloud, DEFAULT) o 'ollama' (100% local).
# Importante: el índice vectorial se construye para UN proveedor (las dimensiones
# difieren). Si cambiás de proveedor, reembebé: `python -m codex_rag.build --full`.
LLM_PROVIDER=gemini

# Gemini (cloud, default). API key en https://aistudio.google.com/apikey
# (NO es la suscripción "Google AI Pro"; es la API key de AI Studio. Tier 1/billing
# recomendado para el re-embed inicial — el free tier no alcanza para el bulk).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_FALLBACK=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Ollama (alternativa 100% local). Activá con LLM_PROVIDER=ollama y EMBED_DIM=1024.
# Requiere: ollama pull bge-m3 && ollama pull gemma3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=gemma3:4b

# ── Opcionales ──────────────────────────────────────────────────────────────
# Todas tienen default; se dejan comentadas a propósito: una línea `VAR=` vacía
# se carga igual y algunas (las numéricas de Python) fallan con valor vacío.
# Descomentá solo la que quieras cambiar.

# GraphRAG: score mínimo de similitud para responder; por debajo, se abstiene.
#RAG_MIN_SCORE=0.76

# Embeddings (`python -m codex_rag.build`): tamaño de lote, pausa entre lotes en
# segundos (para no pegarle al rate limit) y largo máximo por chunk
# (default 6000 con gemini, 20000 con ollama).
#EMBED_BATCH=32
#EMBED_SLEEP=0
#EMBED_MAX_CHARS=6000

# API web (Express): puerto local (en Render manda PORT), intérprete de Python
# que usa /api/chat y límite del chat por IP (pedidos por ventana; ventana en ms).
#API_PORT=3000
#PYTHON_BIN=python
#CHAT_RL_MAX=15
#CHAT_RL_WINDOW_MS=600000

# ── Solo desde la terminal (NO funcionan en este archivo) ──────────────────
# Estos scripts leen la variable antes de cargar el .env (o no lo cargan), así que
# hay que definirlas en la terminal antes de correrlos:
#   AOE_WIKI              web/scripts/build-*.mjs — wiki a parsear
#                         (default D:\Boveda\AoE-Wiki)
#   TREE_DATA_DIR         web/techtree/*.mjs — datos del árbol
#                         (default D:\Proyectos\Aoe2-Tech-Tree-Advanced\public\src\data;
#                         web/scripts/build-*.mjs usan la copia en web/public/tree)
#   AOE2TECHTREE_LOCALES  python -m codex.apply_aliases — locales de aoe2techtree
#                         (default ./data/locales, relativo a donde se corre)
