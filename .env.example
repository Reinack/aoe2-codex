# Ruta absoluta al vault de Obsidian (fuente de verdad, read-only)
VAULT_PATH=D:\Boveda\Aoe

# Carpetas a excluir del ingest (separadas por coma, relativas al vault)
EXCLUDE_DIRS=.obsidian,.trash,raw

# Conexión a Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codexpass

# Proveedor LLM: 'gemini' (cloud, DEFAULT) o 'ollama' (100% local).
# Importante: el índice vectorial se construye para UN proveedor (las dimensiones
# difieren). Si cambiás de proveedor, reembebé: `python -m codex_rag.build --full`.
LLM_PROVIDER=gemini

# Gemini (cloud, default). API key en https://aistudio.google.com/apikey
# (NO es la suscripción "Google AI Pro"; es la API key de AI Studio. Tier 1/billing
# recomendado para el re-embed inicial — el free tier no alcanza para el bulk).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_FALLBACK=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Ollama (alternativa 100% local). Activá con LLM_PROVIDER=ollama y EMBED_DIM=1024.
# Requiere: ollama pull bge-m3 && ollama pull gemma3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=gemma3:4b
