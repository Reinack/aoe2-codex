{
  "name": "aoe2-codex-api",
  "version": "0.1.0",
  "description": "API REST sobre el grafo de conocimiento AoE2 (Express + Neo4j)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "techtree:report": "node techtree/map.mjs --write",
