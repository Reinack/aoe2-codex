{
  "name": "aoe2-codex-api",
  "version": "0.1.0",
  "description": "API REST sobre el grafo de conocimiento AoE2 (Express + Neo4j)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "techtree:report": "node techtree/map.mjs --write",
    "techtree:ingest": "node techtree/ingest.mjs --write",
    "techtree:dry": "node techtree/ingest.mjs",
    "techtree:edges": "node techtree/edges.mjs",
    "techtree:edges:write": "node techtree/edges.mjs --write",
    "data:costs": "node scripts/build-item-costs.mjs",
    "data:castleuus": "node scripts/build-castle-uus.mjs",
    "data:civmods": "node scripts/build-civ-mods.mjs",
    "data:ecotechs": "node scripts/build-eco-techs.mjs",
    "data:eco": "node scripts/build-item-costs.mjs && node scripts/build-castle-uus.mjs && node scripts/build-civ-mods.mjs && node scripts/build-eco-techs.mjs",
    "test": "node --test \"lib/*.test.mjs\"",
    "data:unitclasses": "node scripts/build-unit-classes.mjs",
    "data:buildorders": "node scripts/build-build-orders.mjs",
    "data:team": "node scripts/build-team-roles.mjs",
    "data:lab": "node scripts/build-build-orders.mjs && node scripts/build-team-roles.mjs && node scripts/build-civ-combat.mjs",
    "data:civcombat": "node scripts/build-civ-combat.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "neo4j-driver": "^5.20.0"
  }
}
